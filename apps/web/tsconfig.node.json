// 빌드 도구 설정 (vite.config.ts) · Node 로 도는 테스트 (src/**/*.test.ts)
{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    // 테스트는 node --test 가 .ts 를 바로 읽어 확장자까지 적는다
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["vite.config.ts", "vite.switcher.config.ts", "src/**/*.test.ts"]
}
