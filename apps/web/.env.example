# 로컬 개발(pnpm dev)용. 이 파일을 .env.local 로 복사해 값을 채운다 (.env.local 은 git 에 올라가지 않는다).

# 운영 허브(https://service-hub.dvi-ind.com)에 로그인한 브라우저의 hub_session 쿠키 값.
# vite 프록시가 /api/hub 요청마다 붙여 보낸다. 만료되면 다시 복사한다.
HUB_SESSION_COOKIE=

# 허브 서버 주소. 비우면 https://api.dvi-ind.com/hub (vercel.json rewrites 와 같은 곳)
HUB_API_URL=

# API 로그 단계 — silent · error · info · debug (비우면 개발 debug, 운영 error)
VITE_API_LOG=

# 인사 문구의 날씨를 볼 곳(위도,경도). 비우면 서울. 공장 위치로 맞춘다 — features/hero/lib/greetingContext.ts
VITE_WEATHER_AT=
