// 브라우저에서 도는 화면 코드 (src/)
{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // lib/widgetLayout.ts 는 Node 테스트에서도 돈다 — Node 는 확장자 없는 가져오기를 못 찾는다
    "allowImportingTsExtensions": true
  },
  "include": ["src"],
  // 테스트는 Node 에서 돈다 — tsconfig.node.json
  "exclude": ["src/**/*.test.ts"]
}
