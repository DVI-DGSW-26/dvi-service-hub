# 디비전 로그인 서비스 (OAuth 2.0 / OIDC)
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_AUTHORIZE_URL=
AUTH_TOKEN_URL=
# 선택: 사용자 정보 URL (id_token만으로 이름·이메일이 오면 비워도 됨)
AUTH_USERINFO_URL=
# 선택: 로그인 서비스의 로그아웃 URL
AUTH_LOGOUT_URL=
AUTH_SCOPE=openid profile email

# 운영: https://dvi-service-hub.vercel.app / 로컬: http://localhost:3000
APP_URL=http://localhost:3000
# 세션 쿠키 서명 키 (임의의 긴 문자열)
SESSION_SECRET=
