{
  "name": "dvi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter @dvi/web dev",
    "dev:mock": "pnpm --filter @dvi/web dev:mock",
    "build": "pnpm --filter @dvi/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "check": "pnpm -r typecheck && pnpm -r lint && pnpm -r test"
  }
}
